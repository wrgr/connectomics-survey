analysis/_tmp_*.py
analysis/adjudicate_claim_*.py

# Open-access PDF binaries (catalog is postanalysis/pdfs/paper_links.csv)
postanalysis/pdfs/files/*
!postanalysis/pdfs/files/.gitkeep
postanalysis/pdfs/manual_OA/
postanalysis/pdfs/manual_closed/

# Regenerable LLM response caches (source of record is llm_relevance_results.csv + decisions/)
