# Runtime logs
*.log
*.pid

# Frozen retrieval dump is too large for GitHub (100 MB limit); re-download via
# .github/workflows/postanalysis-semantic-prep.yml. Other source_artifact outputs stay.
source_artifact/**/papers_all.csv
source_artifact/**/retrieval_log.jsonl
# Regenerable duplicate of collection.json
source_artifact/neurotrailblazers_visible_core/collection.jsonl
